{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozykin.local/schemas/v1.1/character.schema.json",
  "title": "CozyKin Character v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "relationship", "personality", "preferences", "appearance", "privacy"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["userAddress"],
      "properties": { "userAddress": { "type": "string", "minLength": 1, "maxLength": 40, "default": "你" } }
    },
    "personality": {
      "type": "object", "additionalProperties": false,
      "required": ["energy", "affection", "curiosity", "shyness", "playfulness"],
      "properties": {
        "energy": { "$ref": "#/$defs/trait" }, "affection": { "$ref": "#/$defs/trait" },
        "curiosity": { "$ref": "#/$defs/trait" }, "shyness": { "$ref": "#/$defs/trait" },
        "playfulness": { "$ref": "#/$defs/trait" }
      }
    },
    "preferences": {
      "type": "object", "additionalProperties": false, "required": ["likes", "dislikes"],
      "properties": { "likes": { "$ref": "#/$defs/stringList" }, "dislikes": { "$ref": "#/$defs/stringList" } }
    },
    "appearance": {
      "type": "object", "additionalProperties": false, "required": ["mustKeep", "mustNotChange"],
      "properties": { "mustKeep": { "$ref": "#/$defs/stringList" }, "mustNotChange": { "$ref": "#/$defs/stringList" } }
    },
    "privacy": {
      "type": "object", "additionalProperties": false, "required": ["localOnly", "sourceDeclaration"],
      "properties": { "localOnly": { "type": "boolean" }, "sourceDeclaration": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "dialogues": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "click": { "$ref": "#/$defs/dialogueList" }, "doubleClick": { "$ref": "#/$defs/dialogueList" },
        "rapidClick": { "$ref": "#/$defs/dialogueList" }, "hiss": { "$ref": "#/$defs/dialogueList" },
        "drag": { "$ref": "#/$defs/dialogueList" }, "sleep": { "$ref": "#/$defs/dialogueList" },
        "wake": { "$ref": "#/$defs/dialogueList" }, "wander": { "$ref": "#/$defs/dialogueList" }
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "effectAnchors": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "sleep": { "$ref": "#/$defs/normalizedPoint" }
          }
        },
        "wakeVariants": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/weightedBehaviorVariant" }
        }
      }
    }
  },
  "$defs": {
    "trait": { "type": "number", "minimum": 0, "maximum": 1 },
    "stringList": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "uniqueItems": true },
    "dialogueList": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
    "normalizedPoint": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "weightedBehaviorVariant": {
      "type": "object", "additionalProperties": false, "required": ["behaviorId", "weight"],
      "properties": {
        "behaviorId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
