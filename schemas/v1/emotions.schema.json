{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozykin.local/schemas/v1/emotions.schema.json",
  "title": "CozyKin Emotions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultEmotion", "randomTransitionsEnabled", "emotions"],
  "properties": {
    "defaultEmotion": { "$ref": "#/$defs/emotionId" },
    "randomTransitionsEnabled": { "type": "boolean" },
    "emotions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/emotion" } }
  },
  "$defs": {
    "emotionId": { "enum": ["neutral", "happy", "sleepy", "curious", "shy", "sad", "annoyed", "excited"] },
    "trigger": { "enum": ["startup", "behavior_complete", "single_click", "double_click", "rapid_click", "drag_start", "drag_end", "idle_timeout", "random"] },
    "emotion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "weight", "durationMs", "triggers", "behaviorId"],
      "properties": {
        "id": { "$ref": "#/$defs/emotionId" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "durationMs": { "type": "integer", "minimum": 500, "maximum": 300000 },
        "triggers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/trigger" }, "uniqueItems": true },
        "behaviorId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" }
      }
    }
  }
}
