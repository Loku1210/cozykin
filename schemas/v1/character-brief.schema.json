{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozykin.local/schemas/v1/character-brief.schema.json",
  "title": "CozyKin Character Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "displayName", "characterType", "relationship", "introduction", "visual", "personality", "behaviors", "emotions", "specialRequirements", "privacyRequirements"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "characterType": { "enum": ["cat", "dog", "other-pet", "original-person", "original-creature", "cartoon", "memorial", "custom"] },
    "relationship": { "type": "object", "additionalProperties": false, "required": ["description", "userAddress"], "properties": { "description": { "type": "string", "maxLength": 300 }, "userAddress": { "type": "string", "minLength": 1, "maxLength": 40 } } },
    "introduction": { "type": "string", "maxLength": 500 },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceImageCount", "style", "bodyProportion", "primaryView", "transparentBackground", "facingDirection", "defaultSize", "shadow", "mustKeep", "mustNotChange", "additionalRequirements"],
      "properties": {
        "referenceImageCount": { "type": "integer", "minimum": 0, "maximum": 100 }, "style": { "type": "string", "maxLength": 100 },
        "bodyProportion": { "type": "string", "maxLength": 100 }, "primaryView": { "type": "string", "maxLength": 100 },
        "transparentBackground": { "type": "boolean" }, "facingDirection": { "enum": ["left", "right", "front", "mixed"] },
        "defaultSize": { "type": "string", "maxLength": 100 }, "shadow": { "type": "boolean" },
        "mustKeep": { "type": "string", "maxLength": 1000 }, "mustNotChange": { "type": "string", "maxLength": 1000 },
        "additionalRequirements": { "type": "string", "maxLength": 3000 }
      }
    },
    "personality": {
      "type": "object", "additionalProperties": false,
      "required": ["energy", "affection", "curiosity", "shyness", "playfulness", "independence", "courage", "warmth", "typicalTraits", "likes", "dislikes", "habits", "backstory"],
      "properties": {
        "energy": { "$ref": "#/$defs/trait" }, "affection": { "$ref": "#/$defs/trait" }, "curiosity": { "$ref": "#/$defs/trait" },
        "shyness": { "$ref": "#/$defs/trait" }, "playfulness": { "$ref": "#/$defs/trait" }, "independence": { "$ref": "#/$defs/trait" },
        "courage": { "$ref": "#/$defs/trait" }, "warmth": { "$ref": "#/$defs/trait" }, "typicalTraits": { "type": "string", "maxLength": 1000 },
        "likes": { "$ref": "#/$defs/stringList" }, "dislikes": { "$ref": "#/$defs/stringList" }, "habits": { "type": "string", "maxLength": 1000 }, "backstory": { "type": "string", "maxLength": 3000 }
      }
    },
    "behaviors": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" }, "uniqueItems": true },
    "emotions": { "type": "object", "additionalProperties": false, "required": ["defaultEmotion", "enabled", "randomTransitionsEnabled"], "properties": { "defaultEmotion": { "$ref": "#/$defs/emotionId" }, "enabled": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/emotionId" }, "uniqueItems": true }, "randomTransitionsEnabled": { "type": "boolean" } } },
    "specialRequirements": { "type": "string", "maxLength": 5000 },
    "privacyRequirements": { "type": "string", "maxLength": 3000 }
  },
  "$defs": {
    "trait": { "type": "number", "minimum": 0, "maximum": 1 },
    "emotionId": { "enum": ["neutral", "happy", "sleepy", "curious", "shy", "sad", "annoyed", "excited"] },
    "stringList": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "uniqueItems": true }
  }
}
