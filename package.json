{
  "name": "cozykin",
  "version": "0.2.1",
  "description": "CozyKin — Personal Desktop Companion Studio",
  "main": "dist-main/main/index.js",
  "author": "Loku",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist-main dist-renderer coverage release",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test": "vitest run",
    "test:importer": "npm run build:main && electron scripts/electron-importer-smoke.cjs examples/cookie.cozykin.zip examples/pudding.cozykin.zip examples/cookie-front.cozykin.zip examples/pudding-front.cozykin.zip",
    "test:importer:fallback": "npm run build:main && node scripts/pack-importer-node-harness.cjs examples/cookie.cozykin.zip examples/pudding.cozykin.zip examples/cookie-front.cozykin.zip examples/pudding-front.cozykin.zip",
    "test:runtime:presentation": "npm run build:main && node scripts/runtime-presentation-smoke.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "audit:brand": "node scripts/brand-audit.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "examples:zip": "node scripts/build-example-packs.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run examples:zip && npm run test:importer && npm run test:runtime:presentation && npm run audit:brand",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:win:x64": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "semver": "^7.7.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@electron/asar": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "pngjs": "^7.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "studio.cozykin.app",
    "productName": "CozyKin",
    "asar": true,
    "asarUnpack": [
      "examples/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "schemas/**/*",
      "examples/**/*",
      "brand/**/*",
      "!examples/*.zip",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": null
  }
}
